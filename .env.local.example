# Copy to .env.local and fill in the values below.

# Apps Script web app URL from scripts/apps-script/Code.gs
# (Deploy -> New deployment -> Web app).
GOOGLE_SHEETS_WEBAPP_URL=

# "Sign in with X" (OAuth 2.0) for the allowlist quest gate. From the X
# Developer Portal: open your app -> User authentication settings -> set up
# OAuth 2.0 -> Type: Web App -> Callback URL: http://localhost:3000/api/auth/x/callback
# (add your production URL's equivalent too once deployed).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Random string used to sign the login session cookie, e.g:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
